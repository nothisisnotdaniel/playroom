<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- RoomKit comes from the local folder feed (see README); everything else from nuget.org. -->
    <add key="roomkit" value="%HOME%/Library/Application Support/RoomKit/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="roomkit">
      <package pattern="RoomKit" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
